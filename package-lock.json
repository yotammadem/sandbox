{
  "name": "sandbox-monorepo",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "sandbox-monorepo",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*",
        "experiments/*"
      ],
      "engines": {
        "node": ">=20",
        "npm": ">=10"
      }
    },
    "apps/hello": {
      "name": "@sandbox/hello",
      "version": "0.0.0",
      "dependencies": {
        "@sandbox/shared": "*"
      }
    },
    "apps/safe-artifact-playground": {
      "name": "@sandbox/safe-artifact-playground",
      "version": "0.0.0"
    },
    "node_modules/@sandbox/hello": {
      "resolved": "apps/hello",
      "link": true
    },
    "node_modules/@sandbox/safe-artifact-playground": {
      "resolved": "apps/safe-artifact-playground",
      "link": true
    },
    "node_modules/@sandbox/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/shared": {
      "name": "@sandbox/shared",
      "version": "0.0.0"
    }
  }
}
